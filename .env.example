# Copy this file to ".env" in the app root and fill in real values.
# The app (server.cjs / db.cjs) loads this automatically via dotenv.
# Never commit the real .env (it is gitignored).

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# --- First-time / reset admin ---
# Used to create the admin on a fresh database (no admin yet), and by
# `node create-admin.cjs` to create or reset the admin on demand.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
